# ==============================================================================
# Signal Stack Environment Variables Configuration
# Copy this file to .env and configure your keys before running the application.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./data/signal_stack.db

# LLM Providers (Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=groq
LLM_CACHE_ENABLED=true

# Web Crawler & Search Politeness Settings
CRAWLER_USER_AGENT=SignalStackBot/1.0 (+https://github.com/Shivasaini2006/Signal-Stack; signalstack@example.com)
CRAWL_DELAY_SECONDS=2.0
ROBOTS_TXT_TIMEOUT_SECONDS=5.0
MAX_CONCURRENT_CRAWLS_PER_DOMAIN=1

# API Server
API_HOST=127.0.0.1
API_PORT=8000
